[Unit]
Description=Danci FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/danci/danci-backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/danci/danci-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077

[Install]
WantedBy=multi-user.target
